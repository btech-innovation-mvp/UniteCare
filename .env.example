# ==============================================================================
# UniteCare — Global Environment Variables Example
# Copy this file to .env in each corresponding workspace or use root-level tooling.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=false
APP_NAME=UniteCare

# --- Backend API Settings ---
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# --- Database Configuration (PostgreSQL) ---
# Replace username, password, host, port, and dbname with genuine deployment values.
POSTGRES_USER=unitecare_user
POSTGRES_PASSWORD=unitecare_secure_local_dev_password
POSTGRES_DB=unitecare_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://unitecare_user:unitecare_secure_local_dev_password@localhost:5433/unitecare_db

# --- Security & Authentication (JWT & Session Tokens) ---
# Generate a high-entropy 64-character secret using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_before_running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate Limiting (Authentication Endpoints) ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5

# --- Cross-Origin Resource Sharing (CORS) ---
# Allowed origins as JSON array string
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]


# --- Frontend Application Settings (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Mobile Application Settings (apps/mobile) ---
# For Android Emulator use 10.0.2.2, for physical device use LAN IP
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
