# ==============================================================================
# UniteCare Root .gitignore
# Multi-stack ignore rules for Python/FastAPI, Node/Next.js, Expo, Docker, & OS
# ==============================================================================

# --- Environments & Secrets (CRITICAL: Never commit real credentials) ---
.env
.env.*
.env*.local
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.cert
*.pfx
secrets/
*.keystore
*.jks
credentials.json
service-account*.json

# --- Archives & Compressed Files ---
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.7z.*
*.iso
*.dmg

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache/

# --- Node & Frontend (Next.js / React) ---
node_modules/
.npm/
.yarn/
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output
.next/
out/
.turbo/
.parcel-cache/

# --- Mobile (Expo / React Native) ---
.expo/
.expo-shared/
web-build/
*.orig.*

# Android / iOS generated builds & artifacts
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab
*.ipa

# --- Database & Persistent Storage ---
pgdata/
postgres_data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.dump
*.sql.gz

# --- Operating System & IDEs ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs & Editors
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
.fleet/

# --- Temporary & Log Files ---
logs/
temp/
tmp/
*.tmp
*.bak

